{
	# Static, stateless container: no admin API, no config autosave
	admin off
	persist_config off
}

http://:8080 {
	root * /srv
	encode zstd gzip

	# Health probe independent of the build output (web/dist may be empty)
	respond /healthz 200

	# One origin for the SPA and the API: the server accepts same-origin
	# requests, so the Host header is forwarded untouched.
	reverse_proxy /api/* {$API_UPSTREAM}
	reverse_proxy /ws/* {$API_UPSTREAM}

	# Hashed bundles never change; packs may
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /packs/* Cache-Control "public, max-age=300, must-revalidate"

	# The SPA's own paths: everything but the proxied API, the health probe
	# and the bundles and packs, which keep their headers and 404 when missing
	@spa not path /api/* /ws/* /healthz /assets/* /packs/*

	# The entry point and any other root path: always revalidated, and app
	# routes such as /g/<id>, which have no file, get index.html
	route @spa {
		header Cache-Control "no-cache"
		try_files {path} /index.html
	}

	file_server
}
